                    >
                      👍
                      <% if (cr.like) { %>
                        <small><%= cr.like %></small>
                      <% } %>
                    </button>

                  </form>


                 

                  <form
                    action="/social/reaction"
                    method="POST"
                  >

                    <input type="hidden" name="targetType" value="comment">
                    <input type="hidden" name="targetId" value="<%= comment.id %>">
                    <input type="hidden" name="reactionType" value="dislike">

                    <button
                      type="submit"
                      class="<%= cr.myReaction === 'dislike'
                        ? 'social-comment-selected'
                        : '' %>"
                      title="Dislike"
                      aria-label="Dislike"
                    >
                      👎
                      <% if (cr.dislike) { %>
                        <small><%= cr.dislike %></small>
                      <% } %>
                    </button>

                  </form>

                  <form
                    action="/social/reaction"
                    method="POST"
                  >

                    <input type="hidden" name="targetType" value="comment">
                    <input type="hidden" name="targetId" value="<%= comment.id %>">
                    <input type="hidden" name="reactionType" value="heart">

                    <button
                      type="submit"
                      class="<%= cr.myReaction === 'heart'
                        ? 'social-comment-selected'
                        : '' %>"
                      title="Heart"
                      aria-label="Heart"
                    >
                      ❤️
                      <% if (cr.heart) { %>
                        <small><%= cr.heart %></small>
                      <% } %>
                    </button>

                  </form>
                

                  <form
                    action="/social/reaction"
                    method="POST"
                  >

                    <input type="hidden" name="targetType" value="comment">
                    <input type="hidden" name="targetId" value="<%= comment.id %>">
                    <input type="hidden" name="reactionType" value="rose">

                    <button
                      type="submit"
                      class="<%= cr.myReaction === 'rose'
                        ? 'social-comment-selected'
                        : '' %>"
                      title="Rose"
                      aria-label="Rose"
                    >
                      🌹
                      <% if (cr.rose) { %>
                        <small><%= cr.rose %></small>
                      <% } %>
                    </button>

                  </form>


                  <!-- SMILE -->

                  <form
                    action="/social/reaction"
                    method="POST"
                  >

                    <input type="hidden" name="targetType" value="comment">
                    <input type="hidden" name="targetId" value="<%= comment.id %>">
                    <input type="hidden" name="reactionType" value="smile">

                    <button
                      type="submit"
                      class="<%= cr.myReaction === 'smile'
                        ? 'social-comment-selected'
                        : '' %>"
                      title="Smile"
                      aria-label="Smile"
                    >
                      😊
                      <% if (cr.smile) { %>
                        <small><%= cr.smile %></small>
                      <% } %>
                    </button>

                  </form>


                

                 <button
  type="button"
