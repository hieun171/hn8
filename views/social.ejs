<section class="py-5 bg-light border border-black mt-4 mb-4">
<% if (totalPages > 1) { %>
  <nav class="social-pagination" aria-label="Social post pagination">

    <% if (page > 1) { %>
      <a
        href="/social/post?page=<%= page - 1 %>"
        class="social-page-btn"
      >
        ← Previous
      </a>
    <% } else { %>
      <span class="social-page-btn disabled">
        ← Previous
      </span>
    <% } %>


    <div class="social-page-numbers">

      <% for (let i = 1; i <= totalPages; i++) { %>

        <% if (i === page) { %>

          <span class="social-page-number active">
            <%= i %>
          </span>

        <% } else { %>
 
          <a
            href="/social/post?page=<%= i %>"
            class="social-page-number"
          >
            <%= i %>
          </a>

        <% } %>

      <% } %>

    </div> 
 

    <% if (page < totalPages) { %>

      <a
        href="/social/post?page=<%= page + 1 %>"
        class="social-page-btn"
      >
        Next →
      </a>

    <% } else { %>

      <span class="social-page-btn disabled">
        Next →
      </span>

    <% } %>

  </nav>
<% } %>
 
