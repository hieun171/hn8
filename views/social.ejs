<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!----> 
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->
  <!---->
  <h2 id="hm">Professional Exchange</h2>
 

<section class="py-5 bg-light border border-black mt-4 mb-4">
    
<div style="background:#fff3cd;padding:10px;">

  <!-- User name + slogan -->
  <div style="margin-top:15px; margin-bottom:15px;">
  <div>
    <strong>Name:</strong>
    <%= currentUserEmail %>
  </div>
 
  <% if (profile) { %>

    <% if (profile.emailpr && profile.emailpr.trim() !== '') { %>
      <div>
        <strong>Email:</strong> <%= profile.emailpr %>
      </div>
    <% } %>

    <% if (profile.phone && profile.phone.trim() !== '') { %>
      <div>
        <strong>Phone:</strong> <%= profile.phone %>
      </div>
    <% } %>
 
  <% } %> 
</div>
  <!-- Profile -->
  <div>

    <% if (profile) { %>

      <% if (profile.avatar && profile.avatar.trim() !== '') { %>
        <img
          src="<%= profile.avatar %>"
          alt="Avatar"
          style="
            width:105px;
            height:105px;
            border-radius:50%;
            object-fit:cover;
            object-position:center;
            display:block;
            margin:0 auto 15px auto;
          "
        />
      <% } %>     

      <% if (profile.website && profile.website.trim() !== '') { %>
        <div>
          <strong>Website:</strong> <%= profile.website %>
        </div>
      <% } %>
        <% if (profile && profile.slogan && profile.slogan.trim() !== '') { %>
      <div>
        <strong>Tagline:</strong> <%= profile.slogan %>
      </div>
    <% } %>
        <% if (profile.address && profile.address.trim() !== '') { %>
        <div>
          <strong>Address:</strong> <%= profile.address %>
        </div>
      <% } %>

    <% } %>

  </div>

</div>

</section>

<section class="py-5 bg-light border border-black mt-4 mb-4">
<!-- Separate section: Update Profile -->
<div style="margin-top:10px;">
  <a href="/social/profile">
   Create/Update Professional Profile →
  </a>
</div>

<hr> 

<!-- Search Posts section -->
<div>
  <h6>
    Click Search Post, Enter your user name, you will find all your posts
  </h6>
</div>

<a
  href="/social/search"
  class="social-search-link"
>
  🔍 Search Posts
</a>

</section>



<section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="container">  

    <div class="social-create-post">

      <div class="social-post-header">

  <div class="social-user">

    <div class="social-avatar">
      U
    </div>

    <div class="social-user-info">

      <div class="social-user-name">
        <strong>Create a post</strong>
      </div>

      <div class="social-create-post-subtitle">
          Choose who can see your post
      </div>

    </div>

  </div>

  
 
</div>
 
      <form
  action="/social/post/create"
  method="POST"
  enctype="multipart/form-data"
  class="social-create-post-form"
  id="socialCreatePostForm"
>
  
  <div
    id="socialPostCreateComposer"
    class="social-post-create-composer"
    contenteditable="true"
    data-placeholder="What's on your mind?"
  ></div>

  <input
    type="hidden"
    name="content"
    id="socialPostCreateContent"
  >
<br>
  <!-- IMAGE -->
  <!-- FILES -->
  
<div class="social-file-upload">

 <label for="socialPostFiles">
  📎 Add images, video, PDF, or CSV Excel
</label>

<input
  type="file"
  id="socialPostFiles"
  name="files"
  accept="
    image/jpeg,
    image/png,
    image/webp,
    image/gif,

    video/mp4,
    video/webm,

    audio/mpeg,
    audio/mp4,
    audio/wav,
    audio/ogg,
    audio/webm,

    application/pdf,

    text/csv,
    application/csv,

    application/vnd.ms-excel,
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,

    application/msword,
    application/vnd.openxmlformats-officedocument.wordprocessingml.document
  "
  multiple
> 
 
  <div id="socialPostFilesPreview"></div>

</div>
  
  <!-- VISIBILITY -->
<div class="social-visibility-options">

  <% if (isClient) { %>

    <!-- =====================================================
         CLIENT
         Client can ONLY create admin_only posts
    ====================================================== -->

    <label>
      <input
        type="radio"
        name="visibility"
        value="admin_only"
        checked
      >
      <span>🔒 Only me + Admin/HN CPA 🔒</span>
    </label>

  <% } else { %>

    <!-- =====================================================
         ALL NON-CLIENT USERS
         Normal 3 visibility options
    ====================================================== -->

    <label>
      <input
        type="radio"
        name="visibility"
        value="loggedin users"
        checked
      >
      <span>
        👨‍👩‍👧‍👧 All Loggedin Users
      </span>
    </label>

    <label>
      <input
        type="radio"
        name="visibility"
        value="group_only"
      >
      <span>
        👥 My Group
      </span>
    </label>

    <label>
      <input
        type="radio"
        name="visibility"
        value="admin_only"
      >
      <span>
        🔒 Admin Only
      </span>
    </label>

    <!-- =====================================================
         ADMIN1 / ADMIN2 ONLY
         Can post to one selected client
    ====================================================== -->
 
    <% if (isAdmin) { %>

      <label>
        <input
          type="radio"
          name="visibility"
          value="client_only"
          id="socialVisibilityClientOnly"
        >
        <span>
          👤 Specific Client Only
        </span>
      </label>

      <div
        id="socialClientSelector"
        style="display:none; margin-top:10px;"
      >

        <label for="socialTargetUserId">
          Select Client:
        </label>

        <select
          name="target_user_id"
          id="socialTargetUserId"
        > 
          <option value="">
            -- Select Client --
          </option>

          <% (clients || []).forEach(client => { %>

            <option value="<%= client.id %>">
              <%= client.email %>
            </option>

          <% }) %>

        </select>

      </div> 

    <% } %>

  <% } %>

</div>


 <!-- VISIBILITY -->
  <div class="social-create-post-footer">

    <span class="social-character-count">
      You can write up to 5000 characters
    </span>

    <button
      type="submit"
      class="social-create-post-button"
    >
      ➤ Post
    </button>

  </div>

</form>
 

 
<hr>
    <!-- ========================================================
         POSTS 
    ========================================================= -->

    <% posts.forEach((post, index) => { %>

      <article
        id="post-<%= post.id %>"
        class="social-post"
        style="--social-post-color: <%= post.color || '#ffffff' %>;"
      >
    <% if (index > 0) { %>
      <hr class="social-post-separator">
    <% } %>
        <!-- ====================================================
             POST HEADER
        ===================================================== -->

        <div class="social-post-header">

          <div class="social-user">

            <div class="social-avatar">
              <%= (post.email || "U").charAt(0).toUpperCase() %>
            </div>

            <div class="social-user-info">

              <div class="social-user-name">
  <a
    href="/social/profile/<%= post.userId %>"
    class="social-profile-link"
  >
    <%= post.email %>
  </a>
</div>

              <div class="social-date">

 <%= post.createdAt   
    ? new Date(post.createdAt).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
      }) 
    : "" 
%>

  <% if (post.visibility === "admin_only") { %>
    · 🔒 Only me + Admin
  <% } %>

  <% if ( 
    post.updatedAt && 
    post.createdAt && 
    new Date(post.updatedAt).getTime() !==  
    new Date(post.createdAt).getTime() 
  ) { %>

    · edited

  <% } %>

</div>

            </div>

          </div>

        </div>  

    

<% if (
  currentUserId &&
  String(currentUserId) === String(post.userId)
) { %>



  <div class="social-owner-actions">

    <!-- EDIT — OWNER ONLY -->
    <details class="social-edit-control">

      <summary
        class="social-menu-button"
        title="Edit post"
        aria-label="Edit post"
      >
        ✏️ <span>Edit</span>
      </summary>

      <form
        action="/social/post/edit"
        method="POST"
        class="social-inline-edit-form"
      >

        <input
          type="hidden"
          name="id"
          value="<%= post.id %>"
        >

        <textarea
          name="content"
          maxlength="5000"
          required
        ><%= post.content %></textarea>

        <div class="social-inline-edit-buttons">

          <button
            type="submit"
            class="social-save-button"
          >
            ✓ Save
          </button>

          <button
            type="button"
            class="social-cancel-button"
            onclick="this.closest('details').removeAttribute('open')"
          >
            Cancel
          </button>

        </div>
 
      </form>

    </details>
 

  
    <form
      action="/social/post/delete"
      method="POST"
      onsubmit="return confirm('Delete this post?');"
    > 

      <input
        type="hidden"
        name="id"
        value="<%= post.id %>"
      >

      <button
        type="submit"
        class="social-menu-button social-delete"
        title="Delete post"
        aria-label="Delete post"
      >
        🗑️ <span>Delete</span>
      </button>

    </form>

  </div>


<% } else if (isAdmin) { %>



  <div class="social-owner-actions">

    <form
      action="/social/post/delete"
      method="POST"
      onsubmit="return confirm('Admin: delete this post?');"
    >

      <input
        type="hidden"
        name="id"
        value="<%= post.id %>"
      >

      <button
        type="submit"
        class="social-menu-button social-delete"
        title="Delete post"
        aria-label="Delete post"
      >
        🗑️ <span>Delete</span>
      </button>

    </form>

  </div>

<% } %>

 

<% if (post.media && post.media.length > 0) { %>

  <div class="social-post-media">

    <% post.media.forEach((file) => { %>

      <div class="social-post-media-item">

        <% if (
          file.mimeType &&
          file.mimeType.startsWith("image/")
        ) { %>

          <img
            src="<%= file.fileUrl %>"
            alt="<%= file.fileName || 'Post image' %>"
            class="social-post-image"
            loading="lazy"
          >

        
<% } else if (
  file.mimeType &&
  file.mimeType.startsWith("video/")
) { %>

  <video
    class="social-post-video"
    controls
    controlsList="nodownload noplaybackrate"
    preload="metadata"
    playsinline
    webkit-playsinline
    <% if (file.thumbnailUrl) { %>
      poster="<%= file.thumbnailUrl %>"
    <% } %>
  >
    <source
      src="<%= file.fileUrl %>"
      type="<%= file.mimeType %>"
    >
 
    Your browser does not support video playback.
  </video>
        <% } else if (
          file.mimeType === "application/pdf"
        ) { %>

          <a
            href="<%= file.fileUrl %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            📄 <%= file.fileName || "PDF document" %>
          </a>

        <% } else { %>

          <a
            href="<%= file.fileUrl %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            📎 <%= file.fileName || "Attached file" %>
          </a>

        <% } %>

        <!-- TEXT FOR THIS SPECIFIC FILE -->

        <% if (file.mediaText) { %>

          <div class="social-post-media-text">
            <%= file.mediaText %>
          </div>

        <% } %>

      </div>

    <% }); %>

  </div>

<% } %>


<!----> 


<div class="social-post-content">
  <%= post.content %>
</div>
       

        <%
          const r = post.reactions || {};

          const totalReactions =
            (r.like || 0) +
            (r.dislike || 0) +
            (r.heart || 0) +
            (r.horse || 0) +
            (r.rose || 0) +
            (r.fly || 0) +
            (r.call || 0) +
            (r.website || 0) +
            (r.email || 0) +
            (r.smile || 0) +
            (r.victory || 0)+
            (r.bell || 0)+
            (r.trophy || 0);
        %>
    

        <% if (totalReactions > 0) { %>

          <div class="social-reaction-summary">

            <span class="social-reaction-icons">

              <% if (r.like) { %>👍<% } %>
              <% if (r.dislike) { %>👎<% } %>
              <% if (r.heart) { %>❤️<% } %>
              <% if (r.rose) { %>🌹<% } %>
              <% if (r.horse) { %>🐴<% } %>
              <% if (r.fly) { %>✈️<% } %>
              <% if (r.call) { %>📞<% } %>
              <% if (r.website) { %>🌐<% } %>
              <% if (r.email) { %>📧<% } %>
              <% if (r.smile) { %>😊<% } %>
              <% if (r.victory) { %>✌️<% } %>
              <% if (r.bell) { %>🔔<% } %>
              <% if (r.trophy) { %>🏆<% } %>

            </span>

            <span class="social-reaction-total">
              <%= totalReactions %>
            </span>

          </div>

        <% } %>


        <!-- ====================================================
             POST ACTION BAR
        ===================================================== -->

        <div class="social-action-bar">
        
          <form
            action="/social/reaction"
            method="POST"
            class="social-reaction-form"
          >

            <input
              type="hidden"
              name="targetType"
              value="post"
            >

            <input
              type="hidden"
              name="targetId"
              value="<%= post.id %>"
            >

            <input
              type="hidden"
              name="reactionType"
              value="like"
            >

            <button
              type="submit"
              class="social-action-button
                <%= r.myReaction === 'like'
                  ? 'social-selected-like'
                  : '' %>"
              title="Like"
              aria-label="Like"
            >
              👍
              <span>Like</span>

              <% if (r.like) { %>
                <small><%= r.like %></small>
              <% } %>

            </button>

          </form>        

          <form
            action="/social/reaction"
            method="POST"
            class="social-reaction-form"
          >

            <input
              type="hidden"
              name="targetType"
              value="post"
            >

            <input
              type="hidden"
              name="targetId"
              value="<%= post.id %>"
            >

            <input
              type="hidden"
              name="reactionType"
              value="dislike"
            >

            <button
              type="submit"
              class="social-action-button
                <%= r.myReaction === 'dislike'
                  ? 'social-selected-dislike'
                  : '' %>"
              title="Dislike"
              aria-label="Dislike"
            >
              👎
              <span>Dislike</span>

              <% if (r.dislike) { %>
                <small><%= r.dislike %></small>
              <% } %>

            </button>

          </form>
       

          <form
            action="/social/reaction"
            method="POST"
            class="social-reaction-form"
          >

            <input
              type="hidden"
              name="targetType"
              value="post"
            >

            <input
              type="hidden"
              name="targetId"
              value="<%= post.id %>"
            >

            <input
              type="hidden"
              name="reactionType"
              value="heart"
            >

            <button
              type="submit"
              class="social-action-button
                <%= r.myReaction === 'heart'
                  ? 'social-selected-heart'
                  : '' %>"
              title="Heart"
              aria-label="Heart"
            >
              ❤️
              <span>Heart</span>

              <% if (r.heart) { %>
                <small><%= r.heart %></small>
              <% } %>

            </button>

          </form>
         

          <details class="social-more">

            <summary
              class="social-action-button"
              title="More reactions"
            >
              😊 <span>More</span>
            </summary>
 
            <div class="social-reaction-popup">

              <%
                const reactionList = [
                  ["rose", "🌹", "Rose"],
                  ["horse", "🐴", "Horse"],
                  ["fly", "✈️", "Fly"],
                  ["call", "📞", "Call"],
                  ["website", "🌐", "Website"],
                  ["email", "📧", "Email"],
                  ["smile", "😊", "Smile"],
                  ["victory", "✌️", "Victory"],
                  ["bell", "🔔", "Bell"],
                  ["trophy", "🏆", "Trophy"]
                ];
              %>
 
              <% reactionList.forEach(([type, emoji, name]) => { %>

                <form
                  action="/social/reaction"
                  method="POST"
                >

                  <input
                    type="hidden"
                    name="targetType"
                    value="post"
                  >

                  <input
                    type="hidden"
                    name="targetId"
                    value="<%= post.id %>"
                  >

                  <input
                    type="hidden"
                    name="reactionType"
                    value="<%= type %>"
                  >

                  <button
                    type="submit"
                    class="social-popup-reaction
                      <%= r.myReaction === type
                        ? 'social-selected-reaction'
                        : '' %>"
                    title="<%= name %>"
                    aria-label="<%= name %>"
                  >
                    <span><%= emoji %></span>

                    <% if (r[type]) { %>
                      <small><%= r[type] %></small>
                    <% } %>

                  </button>

                </form>

              <% }) %>

            </div>

          </details>


       

          <button
            type="button"
            class="social-action-button"
            onclick="socialFocusComment(<%= post.id %>)"
            title="Comment"
            aria-label="Comment"
          >
            💬 <span>Comment</span>
          </button>


<button
  type="button"
  class="social-action-button social-share-button"
  data-post-id="<%= post.id %>"
  title="Share post"
  aria-label="Share post"
  disabled
>
  🔗
  <span>Share</span>
</button>
        </div>
      

        <div class="social-comments">

          <% (post.comments || []).forEach(comment => { %>

            <div class="social-comment">

              <div class="social-comment-avatar">
                <%= (comment.email || "U").charAt(0).toUpperCase() %>
              </div>


              <div class="social-comment-body">



                <div class="social-comment-bubble">

                  <div class="social-comment-user">
                    <%= comment.email %>
                  </div>

                  <div class="social-comment-text">
                    <%= comment.content %>
                  </div>

                  <% if (
                    comment.updatedAt &&
                    comment.createdAt &&
                    new Date(comment.updatedAt).getTime() !==
                    new Date(comment.createdAt).getTime()
                  ) { %>

                    <small class="social-edited-label">
                      edited
                    </small>

                  <% } %>

                </div>


                <!-- =================================================
                     COMMENT OWNER CONTROLS
                ================================================== -->

                <% if (
                  currentUserId &&
                  String(currentUserId) === String(comment.userId)
                ) { %>

                  <div class="social-comment-owner-actions">

                    <details class="social-edit-control">

                      <summary
                        class="social-menu-button"
                        title="Edit comment"
                        aria-label="Edit comment"
                      >
                        ✏️ <span>Edit</span>
                      </summary>

                      <form
                        action="/social/comment/edit"
                        method="POST"
                        class="social-inline-edit-form"
                      >

                        <input
                          type="hidden"
                          name="id"
                          value="<%= comment.id %>"
                        >

                        <textarea
                          name="content"
                          maxlength="2000"
                          required
                        ><%= comment.content %></textarea>

                        <div class="social-inline-edit-buttons">

                          <button
                            type="submit"
                            class="social-save-button"
                          >
                            ✓ Save
                          </button>

                          <button
                            type="button"
                            class="social-cancel-button"
                            onclick="this.closest('details').removeAttribute('open')"
                          >
                            Cancel
                          </button>

                        </div>

                      </form>

                    </details>


                    <form
                      action="/social/comment/delete"
                      method="POST"
                      onsubmit="return confirm('Delete this comment?');"
                    >

                      <input
                        type="hidden"
                        name="id"
                        value="<%= comment.id %>"
                      >

                      <button
                        type="submit"
                        class="social-menu-button social-delete"
                        title="Delete comment"
                        aria-label="Delete comment"
                      >
                        🗑️ <span>Delete</span>
                      </button>

                    </form>

                  </div>

                <% } %>             

                <%
