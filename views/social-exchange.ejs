<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
 <form>
  <label for="date">Date:</label>
  <input
    type="date"
    id="date"
    name="date"
    value="<%= defaultDate %>"
  />
</form>

<h2 id="hm">Professional Exchange</h2>

 <br>

  <section class="social-public-page py-5 bg-light">

  <div class="container social-public-container">

    <% if (posts && posts.length) { %>

      <% posts.forEach((post, index) => { %>

        <article
          id="post-<%= post.id %>"
          class="social-post social-public-post"
          style="--social-post-color: <%= post.color || '#ffffff' %>;"
        >

          <!-- ====================================================
               POST HEADER
          ===================================================== -->

          <div class="social-post-header">

            <div class="social-user">

              <div class="social-avatar">
                <%= (post.email || "U").charAt(0).toUpperCase() %>
              </div>

              <div class="social-user-info">

             <div class="social-user-name">
  <a
    href="/social/profile/<%= post.userId %>"
    class="social-user-profile-link"
  >
    <%= post.email || "User" %>
  </a>
</div>




                <div class="social-date">

 <%= post.createdAt
  ? new Date(post.createdAt).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric"
    })
  : ""
%>
 
  <% if (post.visibility === "loggedin users") { %>
    · 👨‍👩‍👧‍👧👩‍👩‍👧‍👦 All Loggedin Users 👨‍👩‍👧‍👧👩‍👩‍👧‍👦
  <% } %>

  <% if (post.visibility === "admin_only") { %>
    · 🔒 Only me + HN CPA 🔒
  <% } %>

  <% if (post.visibility === "group_only") { %>
    · 👥 My Group 👥
  <% } %>

  <% if (
    post.updatedAt &&
    post.createdAt &&
    post.updatedAt !== post.createdAt
  ) { %>
    · edited
  <% } %>

</div>
              </div>

            </div>

          </div>


          <!-- ====================================================
               POST CONTENT
          ===================================================== -->

          <% if (post.content) { %>

            <div class="social-post-content">
              <%= post.content %>
            </div>

          <% } %>


          <!-- ====================================================
               POST MEDIA
          ===================================================== -->

         <% if (post.media && post.media.length > 0) { %>

  <div class="social-post-media">

    <% post.media.forEach((file) => { %>

      <div class="social-post-media-item">

        <!-- IMAGE -->
        <% if (
          file.mimeType &&
          file.mimeType.startsWith("image/")
        ) { %>

          <img
            src="<%= file.fileUrl %>"
            alt="<%= file.fileName || 'Post image' %>"
            class="social-post-image"
            loading="lazy"
          >
 
     
<% } else if (
  file.mimeType &&
  file.mimeType.startsWith("video/")
) { %>

 <div class="social-post-video-wrapper">
  <video
    class="social-post-video"
    controls
    controlsList="nodownload noplaybackrate"
    preload="metadata"
    playsinline
    webkit-playsinline
    <% if (file.thumbnailUrl) { %>
      poster="<%= file.thumbnailUrl %>"
    <% } %>
  >
    <source
      src="<%= file.fileUrl %>"
      type="<%= file.mimeType || 'video/mp4' %>"
    >

    Your browser does not support video playback.
  </video>
</div>

 

       
        <% } else if (
          file.mimeType === "application/pdf"
        ) { %>

          <a
            href="<%= file.fileUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            class="social-public-pdf"
          >
            📄 <%= file.fileName || "View PDF" %>
          </a>

        <!-- OTHER FILE -->
        <% } else { %>

          <a
            href="<%= file.fileUrl %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            📎 <%= file.fileName || "Attached file" %>
          </a>

        <% } %>

        <!-- TEXT FOR THIS MEDIA ITEM -->
        <% if (file.mediaText) { %>

          <div class="social-post-media-text">
            <%= file.mediaText %>
          </div>

        <% } %>

      </div>

    <% }) %>

  </div>

<% } %>

          <!-- ====================================================
               POST REACTIONS
          ===================================================== -->

          <% if (post.reactions) { %>

            <div class="social-post-reactions">

              <% if (post.reactions.like > 0) { %>
                <span>
                  👍 <strong><%= post.reactions.like %></strong>
                </span>
              <% } %>

              <% if (post.reactions.dislike > 0) { %>
                <span>
                  👎 <strong><%= post.reactions.dislike %></strong>
                </span>
              <% } %>

              <% if (post.reactions.heart > 0) { %>
                <span>
                  ❤️ <strong><%= post.reactions.heart %></strong>
                </span>
              <% } %>

              <% if (post.reactions.horse > 0) { %>
                <span>
                  🐴 <strong><%= post.reactions.horse %></strong>
                </span>
              <% } %>

              <% if (post.reactions.rose > 0) { %>
                <span>
                  🌹 <strong><%= post.reactions.rose %></strong>
                </span>
              <% } %>

              <% if (post.reactions.fly > 0) { %>
                <span>
                  🪰 <strong><%= post.reactions.fly %></strong>
                </span>
              <% } %>

              <% if (post.reactions.call > 0) { %>
                <span>
                  📞 <strong><%= post.reactions.call %></strong>
                </span>
              <% } %>

              <% if (post.reactions.website > 0) { %>
                <span>
                  🌐 <strong><%= post.reactions.website %></strong>
                </span>
              <% } %>

              <% if (post.reactions.email > 0) { %>
                <span>
                  ✉️ <strong><%= post.reactions.email %></strong>
                </span>
              <% } %>

              <% if (post.reactions.smile > 0) { %>
                <span>
                  🙂 <strong><%= post.reactions.smile %></strong>
                </span>
              <% } %>
              <% if (post.reactions.bell > 0) { %>
  <span>
    🔔 <strong><%= post.reactions.bell %></strong>
  </span>
<% } %>

<% if (post.reactions.trophy > 0) { %>
  <span>
    🏆 <strong><%= post.reactions.trophy %></strong>
  </span>
<% } %> 

              <% if (post.reactions.victory > 0) { %>
                <span>
                  ✌️ <strong><%= post.reactions.victory %></strong>
                </span>
              <% } %>

            </div>

          <% } %>


        </article>


        <!-- ====================================================
             SEPARATOR BETWEEN POSTS
        ===================================================== -->

        <% if (index < posts.length - 1) { %>
          <hr>
        <% } %>


      <% }) %>

    <% } else { %>

      <p class="social-public-empty">
        No public posts.
      </p>

    <% } %>

  </div>

</section>
   <!---->
    <section class="py-5 bg-light border border-black mt-4 mb-4">
   <% if (pagination.totalPages > 1) { %>

  <div class="public-post-pagination">

    <% if (pagination.hasPrevious) { %>
      <a
        href="/social/exchange?page=<%= pagination.previousPage %>"
        class="public-post-pagination__nav"
      >
        ← Previous
      </a>
    <% } else { %>
      <span class="public-post-pagination__nav public-post-pagination__disabled">
        ← Previous
      </span>
    <% } %>


    <% for (let i = 1; i <= pagination.totalPages; i++) { %>

      <% if (
        i === 1 ||
        i === pagination.totalPages ||
        (i >= pagination.page - 2 && i <= pagination.page + 2)
      ) { %>

        <a
          href="/social/exchange?page=<%= i %>"
          class="public-post-pagination__page <%= i === pagination.page ? 'public-post-pagination__active' : '' %>"
        >
          <%= i %>
        </a>

      <% } else if (
        i === pagination.page - 3 ||
        i === pagination.page + 3
      ) { %>

        <span class="public-post-pagination__dots">...</span>

      <% } %>

    <% } %>


    <% if (pagination.hasNext) { %>
      <a
        href="/social/exchange?page=<%= pagination.nextPage %>"
        class="public-post-pagination__nav"
      >
        Next →
      </a>
    <% } else { %>
      <span class="public-post-pagination__nav public-post-pagination__disabled">
        Next →
      </span>
    <% } %>

  </div>

<% } %>


     </section>
  <!---->
 

  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>
<script src="/js/socialpublic.js"></script>

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
   