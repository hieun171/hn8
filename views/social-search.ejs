<section class="social-search-page">

  <div class="social-search-container">

    <!-- ======================================================
         HEADER
    ======================================================= -->
 
    <section class="py-5 bg-light border border-black mt-4 mb-4">

      <div class="container-fluid">

        <div class="social-search-header">

          <div>

            <h2>Search Posts</h2>

            <p>
              Search posts by content or name.
            </p>

          </div>

          <a
            href="/social/post"
            class="social-search-back"
          >
            ← Back to Feed
          </a>

        </div>
 

        <!-- ======================================================
             SEARCH FORM
        ======================================================= -->

        <div class="social-search-card">

          <form
            method="GET"
            action="/social/search"
            class="social-search-form"
          >

            <div class="social-search-field">

              <label for="social-search-q">
                Search posts
              </label>

              <input
                id="social-search-q"
                type="search"
                name="q"
                value="<%= q %>"
                placeholder="Search post content..."
                autocomplete="off"
              >

            </div> 
            <br>

            <div class="social-search-field">

              <label for="social-search-user">
                 Search names
              </label>

              <input
                id="social-search-user"
                type="search"
                name="user"
                value="<%= user %>"
                placeholder="Search by  name..."
                autocomplete="off"
              >

            </div>


            <!-- ======================================================
                 DATE RANGE
                 AVAILABLE TO ALL USERS
            ======================================================= -->

            <div class="social-admin-filter-group">

              <label class="social-admin-filter-main-label">
                Date Posted
              </label>

              <div class="social-admin-filter-date-range">

                <div class="social-admin-filter-date">

                  <label for="social-search-date-from">
                    From
                  </label>
 
                  <input
                    id="social-search-date-from"
                    type="date"
                    name="dateFrom"
                    value="<%= dateFrom || '' %>"
                  >

                </div>


                <div class="social-admin-filter-date">

                  <label for="social-search-date-to">
                    To
                  </label>

                  <input
                    id="social-search-date-to"
                    type="date"
                    name="dateTo"
                    value="<%= dateTo || '' %>"
                  >

                </div>

              </div>

            </div>


            <div class="social-search-actions">

              <button
                type="submit"
                class="social-search-button"
              >
                🔍 Search
              </button>

              <a
                href="/social/search"
                class="social-search-clear"
              >
                Clear
              </a>

            </div>

          </form>

        </div>

      </div>

    </section>


    <!-- ======================================================
         RESULTS INFO
    ======================================================= -->

    <section class="py-5 bg-light border border-black mt-4 mb-4">

      <div class="container-fluid">

        <div class="social-search-results-header">

          <% if (totalPosts > 0) { %>

            <strong>

              <%= totalPosts %>

              <%= totalPosts === 1 ? "post" : "posts" %>

              found

            </strong>

          <% } else { %>

            <strong>
              No posts found
            </strong>

          <% } %>
   <!-- ======================================================
               FULL  BREAKDOWN ONLY
          ======================================================= -->

        <% if (totalPosts > 0) { %>

  <div class="social-search-admin-breakdown">

    <span class="social-search-everyone">

      👨‍👩‍👧‍👧👩‍👩‍👧‍👦 Loggedin Users:

      <strong>
        <%= everyonePosts %>
      </strong>

    </span>

    <span class="social-search-admin-only">

      🔒 User + Hieu Nguyen, CPA only:

      <strong>
        <%= userAdminPosts %>
      </strong>

    </span>

    <span class="social-search-group-only">

      👥 Group: 

      <strong>
        <%= groupPosts %>
      </strong>

    </span>

  </div>

<% } %>
 


          <!-- ======================================================
               FULL BREAKDOWN ONLY
          ======================================================= -->

         

        <!-- ======================================================
             RESULTS
        ======================================================= -->

      <% if (posts.length) { %>

<section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="container-fluid">

    <div class="social-admin-filter-header">

      <h2>
        Social Public / Connection Management
      </h2>

      <p>
        Manage public visibility and public reactions independently.
      </p>

    </div>


    <div class="table-responsive">

      <table class="table table-bordered table-striped align-middle">

        <thead>

          <tr>

            <th>Name</th>
            <th>Post Contents</th>
            <th>Visibility</th>
            <th>Public</th>
            <th>Public Connections</th>
            <th>Click to View</th>

          </tr>

        </thead>


        <tbody>

          <% posts.forEach(post => { %>

            <tr>

              <!-- USER -->

             <td>

        <a
          href="/social/profile/<%= post.userId %>"
          class="social-search-user-link"
        >
          <strong>
            <%= post.email %>
          </strong>
        </a>

        <br>
<small>
  <%= new Date(post.createdAt).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric"
  }) %>
</small>
        

      </td>


              <!-- POST -->

              <td>

                <div
                  style="
                    max-width: 350px;
                    white-space: normal;
                    word-break: break-word;
                  "
                >
                  <%= post.content %>
                </div>

              </td>


              <!-- VISIBILITY -->

              <td>

                <% if (post.visibility === "admin_only") { %>

                  🔒 Admin Only

                <% } else if (post.visibility === "group_only") { %>

                  👥 Group

                <% } else { %>

                  👨‍👩‍👧‍👧 Loggedin Users

                <% } %>

              </td>
 

              <!-- PUBLIC -->

              <td>

                <% if (post.publicEnabled) { %>

                  <span class="social-public-status">
                    🌎 Public
                  </span>

                  <% if (isAdmin) { %>

                    <br>

                    <form
                      action="/social/post/make-unpublic/<%= post.id %>"
                      method="POST"
                      style="margin-top: 6px;"
                    >

                      <button
                        type="submit"
                        class="social-make-public-btn"
                      >
                        🔒 Unpublish
                      </button>

                    </form>

                  <% } %>

                <% } else { %>

                  <span class="text-muted">
                    🔒 Not Public
                  </span>

                  <% if (isAdmin) { %>

                    <br>

                    <form
                      action="/social/post/make-public/<%= post.id %>"
                      method="POST"
                      style="margin-top: 6px;"
                    >

                      <button
                        type="submit"
                        class="social-make-public-btn"
                      >
                        🌎 Make Public
                      </button>

                    </form>

                  <% } %>

                <% } %>

              </td>


              <!-- PUBLIC REACTIONS -->

              <td>

                <% if (post.publicReactionsEnabled) { %>

                  <span class="social-public-status">
                    👍 Enabled
                  </span>

                  <% if (isAdmin) { %>

                    <br>

                    <form
                      action="/social/post/disable-public-reactions/<%= post.id %>"
                      method="POST"
                      style="margin-top: 6px;"
                    >

                      <button
                        type="submit"
                        class="social-make-public-btn"
                      >
                        🔒 Disable
                      </button>

                    </form>

                  <% } %>

                <% } else { %>

                  <span class="text-muted">
                    👍 Disabled
                  </span>

                  <% if (isAdmin) { %>

                    <br>

                    <form
                      action="/social/post/enable-public-reactions/<%= post.id %>"
                      method="POST"
                      style="margin-top: 6px;"
                    >

                      <button
                        type="submit"
                        class="social-make-public-btn"
                      >
                        👍 Enable
                      </button>

                    </form>

                  <% } %>

                <% } %>

              </td>


              <!-- ACTIONS -->

            <!-- ACTIONS -->

<td>

  <a
    href="/social/post?postId=<%= post.id %>"
    class="social-search-view"
  >
    View Post →
  </a>

</td>



            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</section>

<% } %>


    <!-- ======================================================
         PAGINATION
    ======================================================= -->

    <section class="py-5 bg-light border border-black mt-4 mb-4">

      <div class="container-fluid">

        <% if (totalPages > 1) { %>

          <nav
            class="social-search-pagination"
            aria-label="Search results pagination"
          >

            <%
              const paginationParams = (pageNumber) => {

                const params = new URLSearchParams();

                if (q) {
                  params.set("q", q);
                }

                if (user) {
                  params.set("user", user);
                }

                if (dateFrom) {
                  params.set("dateFrom", dateFrom);
                }

                if (dateTo) {
                  params.set("dateTo", dateTo);
                }

                /*
                 * IMPORTANT:
                 * Preserve visibility when:
                 * - FULL ADMIN uses the filter
                 * - EMAILS_ADMIN uses the filter
                 */

                if (
                  visibility &&
                  (isAdmin || isEmailsAdmin)
                ) {
                  params.set("visibility", visibility);
                }

                params.set("page", pageNumber);

                return params.toString();
              };
            %>


            <!-- PREVIOUS -->

            <% if (page > 1) { %>

              <a
                href="/social/search?<%= paginationParams(page - 1) %>"
                class="social-search-page-button social-search-page-prev"
              >
                ← Previous
              </a>
           

            <% } else { %>

              <span
                class="social-search-page-button social-search-page-prev disabled"
              >
                ← Previous
              </span>

            <% } %>


            <!-- NUMBERED PAGES -->

            <div class="social-search-page-numbers">

              <% for (
                let pageNumber = 1;
                pageNumber <= totalPages;
                pageNumber++
              ) { %>

                <a
                  href="/social/search?<%= paginationParams(pageNumber) %>"
                  class="social-search-page-button social-search-page-number <%= pageNumber === page ? 'active' : '' %>"
                  aria-label="Page <%= pageNumber %>"
                  <%= pageNumber === page ? 'aria-current="page"' : '' %>
                >

                  <%= pageNumber %>

                </a>

              <% } %>

            </div>
 

            <!-- NEXT -->

            <% if (page < totalPages) { %>

              <a
                href="/social/search?<%= paginationParams(page + 1) %>"
                class="social-search-page-button social-search-page-next"
              >
                Next →
              </a>

            <% } else { %>

              <span
                class="social-search-page-button social-search-page-next disabled"
              >
                Next →
              </span>

            <% } %>

          </nav>

        <% } %>

      </div>

    </section>


    <!-- ======================================================
         ADMIN / EMAILS_ADMIN POST FILTER
    ======================================================= -->

    <section class="py-5 bg-light border border-black mt-4 mb-4">

      <% if (isAdmin || isEmailsAdmin) { %>

        <section class="social-admin-filter-section">

          <div class="container-fluid">

            <div class="social-admin-filter-header">

              <h2>
                Filter Posts
              </h2>

              <p>
                Filter posts by visibility and date posted.
              </p>

            </div>


            <form
              method="GET"
              action="/social/search"
              class="social-admin-filter-form"
            >


              <!-- ==================================================
                   VISIBILITY
              =================================================== -->

              <div class="social-admin-filter-group">

                <label class="social-admin-filter-main-label">
                  Filter by visibility
                </label>

                <div class="social-admin-filter-radio-options">


                  <!-- ==================================================
                       LOGGEDIN USERS
                       FULL ADMIN + EMAILS_ADMIN
                  =================================================== -->

                  <label class="social-admin-filter-radio">

                    <input
                      type="radio"
                      name="visibility"
                      value="loggedin users"
                      <%= visibility === "loggedin users" ? "checked" : "" %>
                    >

                    <span>
                      👨‍👩‍👧‍👧👩‍👩‍👧‍👦 Loggedin users
                    </span>

                  </label>


                  <!-- ==================================================
                       ADMIN ONLY
                       FULL ADMIN ONLY
                  =================================================== -->

                  <% if (isAdmin) { %>

                    <label class="social-admin-filter-radio">

                      <input
                        type="radio"
                        name="visibility"
                        value="admin_only"
                        <%= visibility === "admin_only" ? "checked" : "" %>
                      >

                      <span>
                        🔒 Only me + Admin
                      </span>

                    </label>

                  <% } %>


                  <!-- ==================================================
                       GROUP ONLY
                       FULL ADMIN + EMAILS_ADMIN
                  =================================================== -->

                  <label class="social-admin-filter-radio">

                    <input
                      type="radio"
                      name="visibility"
                      value="group_only"
                      <%= visibility === "group_only" ? "checked" : "" %>
                    >

                    <span>
                      👥 Group
                    </span>

                  </label>


                </div>

              </div>


              <!-- ==================================================
                   DATE RANGE
              =================================================== -->

              <div class="social-admin-filter-group">

                <label class="social-admin-filter-main-label">
                  Date Posted
                </label>

                <div class="social-admin-filter-date-range">

                  <div class="social-admin-filter-date">

                    <label for="social-admin-date-from">
                      From
                    </label>

                    <input
                      id="social-admin-date-from"
                      type="date"
                      name="dateFrom"
                      value="<%= dateFrom || '' %>"
                    >

                  </div>


                  <div class="social-admin-filter-date">

                    <label for="social-admin-date-to">
                      To
                    </label>

                    <input
                      id="social-admin-date-to"
                      type="date"
                      name="dateTo"
                      value="<%= dateTo || '' %>"
                    >

                  </div>

                </div>

              </div>


              <!-- ==================================================
                   BUTTONS
              =================================================== -->

              <div class="social-admin-filter-actions">

                <button
                  type="submit"
                  class="social-admin-filter-button"
                >
                  🔎 Filter
                </button>

                <a
                  href="/social/search"
                  class="social-admin-filter-clear"
                >
                  Clear Filters
                </a>

              </div>


            </form>
<section class="py-5 bg-light border border-black mt-4 mb-4">
  <a
    class="dropdown-item"
    href="/social-admin-downloads"
  >
    📥 Social Interact Downloads
  </a>
 
   
      <a
